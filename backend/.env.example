# Copy to an ignored local environment file and replace placeholders locally.
SPRING_PROFILES_ACTIVE=local

DB_URL=jdbc:postgresql://localhost:5432/school_portal
DB_USERNAME=school_portal
DB_PASSWORD=<local-password>

DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=8h

LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=10m

UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=12MB

APP_LOG_LEVEL=INFO

IMAGEKIT_PRIVATE_KEY=<imagekit-private-key>
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<imagekit-id>

# Set these only for the initial principal bootstrap, then remove them.
ADMIN_INITIAL_EMAIL=<principal-email>
ADMIN_INITIAL_PASSWORD=<initial-principal-password>
ADMIN_INITIAL_SCHOOL_SLUG=<school-slug>

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70
