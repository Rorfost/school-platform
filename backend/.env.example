# Do not commit an actual .env file or production credentials.
SPRING_PROFILES_ACTIVE=local
FRONTEND_URL=http://localhost:5173
DB_URL=jdbc:postgresql://localhost:5432/school_portal
DB_USERNAME=school_portal
DB_PASSWORD=
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=8h
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=12MB
APP_LOG_LEVEL=INFO
# Bootstrap is prepared for the future authentication phase. Keep it disabled until that flow exists.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
R2_ENDPOINT=http://localhost:9000
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=school-public
R2_PRIVATE_BUCKET=school-private
R2_PUBLIC_BASE_URL=http://localhost:9000
