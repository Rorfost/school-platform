# VITE_* values are public browser configuration. Do not put secrets here.
VITE_API_BASE_URL=http://localhost:8080
VITE_ASSET_BASE_URL=http://localhost:9000
# Direct backend URL for large uploads that bypass the Cloudflare Worker proxy.
# Set to the same value as VITE_API_BASE_URL in local dev and to the backend origin in CF Pages.
VITE_UPLOAD_BASE_URL=http://localhost:8080
